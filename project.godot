; Lái Xe 3D - Godot 4.7

config_version=5

[application]

config/name="Learn to Drive 3D"
config/name_localized={
"en": "Learn to Drive 3D",
"vi": "Tập Lái Xe 3D"
}
config/description="Lái ô tô góc nhìn thứ nhất, luyện thi sa hình B"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.05, 0.055, 0.07, 1)
boot_splash/image="res://splash.png"
boot_splash/fullsize=false

[autoload]

Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
anti_aliasing/quality/msaa_3d=0
